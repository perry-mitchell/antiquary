{
  "name": "@antiquary/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "migrate": "tsx src/migrate.ts latest",
    "migrate:down": "tsx src/migrate.ts down",
    "migrate:status": "tsx src/migrate.ts status",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "kysely": "^0.29.8",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@antiquary/tsconfig": "*",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15"
  }
}
